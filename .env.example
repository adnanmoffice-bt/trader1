# ─── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_CHAT_ID=your_chat_id_here
# External signals ingestor (2026-05-13). The reader bot must be added to
# the source group AND have Privacy Mode disabled via @BotFather. Keep it
# SEPARATE from TELEGRAM_BOT_TOKEN (outbound notifier) so a token rotation
# on one bot doesn't kill both paths.
TELEGRAM_SIGNALS_BOT_TOKEN=
TELEGRAM_SIGNALS_GROUP_ID=-3910126970
# Phase 1 default: ingest + parse only. Flip to 'true' only after Phase 2
# parser is validated against real messages.
TELEGRAM_SIGNALS_EXECUTOR_ENABLED=false
# Phase 3 dry-run: when 'true', the executor logs what it WOULD do but never
# POSTs to IG. Keep ON for the first 24h of live operation.
TELEGRAM_SIGNALS_EXECUTOR_DRY_RUN=true
# Reject signals older than this many minutes (physical freshness floor).
TELEGRAM_SIGNALS_MAX_AGE_MIN=5
# Fallback sizing if a signal doesn't carry a "X lots per $1000" hint.
TELEGRAM_SIGNALS_DEFAULT_LOTS_PER_1000=0.1
# Comma-separated list of instruments the executor is allowed to trade.
# Default: XAU/USD only. Anything else gets skip_reason='not-in-allowlist'.
# Extend later by adding (e.g.) 'XAU/USD,EUR/USD' when you trust those signals.
TELEGRAM_SIGNALS_ALLOWED_INSTRUMENTS=XAU/USD
# When 'true', only ingest messages that are forwards (the Signal Feed
# channel auto-forwards into the group; hand-typed chat is ignored).
TELEGRAM_SIGNALS_REQUIRE_FORWARD=true
# Optional allowlist of source chats. Accepts numeric chat ids
# ('-1001234567'), '@username', or exact channel titles ('Signal Feed').
# Comma-separated. Empty = accept any forward source.
TELEGRAM_SIGNALS_FORWARD_FROM=Signal Feed
# Webhook secret — Telegram echoes this on every inbound POST as the
# X-Telegram-Bot-Api-Secret-Token header. Required for the push-based
# /api/telegram/webhook endpoint. Generate any random 32+ char string.
# When set, run scripts/setup-telegram-webhook.mjs set <vercel-url> ONCE
# to register the webhook with Telegram. Doing so disables getUpdates
# polling — remove the telegram-ingestor cron from vercel.json afterwards.
TELEGRAM_WEBHOOK_SECRET=

# ─── WhatsApp (Green API) ────────────────────────────────────────────────────
# Fallback if user_settings table has no WhatsApp config
GREEN_API_INSTANCE_ID=
GREEN_API_TOKEN=
GREEN_API_GROUP_ID=
GREEN_API_URL=https://7107.api.greenapi.com

# ─── External APIs ────────────────────────────────────────────────────────────
# Binance — no auth needed for market data, only for trading
BINANCE_API_KEY=
BINANCE_SECRET_KEY=

# IG Group (CFD broker, used for gold/oil/FX/indices) — all four required.
# Generate the API key at MyIG → Settings → My API Keys.
# IG_BASE_URL is optional. Defaults to live (api.ig.com/gateway/deal).
# For demo testing override to: https://demo-api.ig.com/gateway/deal
IG_API_KEY=
IG_USERNAME=
IG_PASSWORD=
IG_ACCOUNT_ID=
IG_BASE_URL=

# Alpha Vantage — free: 25 req/day, paid: $50/mo for 75 req/min
ALPHA_VANTAGE_API_KEY=

# CoinGecko — demo key: 30 req/min (register at coingecko.com/api)
COINGECKO_API_KEY=CG-...

# Finnhub — free: 60 req/min (register at finnhub.io)
FINNHUB_API_KEY=

# NewsAPI — free: 100 req/day (register at newsapi.org)
NEWS_API_KEY=

# ─── Polymarket ───────────────────────────────────────────────────────────────
# Read-only: no auth needed
# Trading: requires Ethereum private key
POLYMARKET_PRIVATE_KEY=

# ─── Kalshi ───────────────────────────────────────────────────────────────────
KALSHI_API_KEY=
KALSHI_PRIVATE_KEY_PATH=./kalshi_private.pem

# ─── Security ─────────────────────────────────────────────────────────────────
CRON_SECRET=change_this_to_a_random_string_min_32_chars

# ─── App Config ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_PAPER_TRADING_CAPITAL=200000
NEXT_PUBLIC_CURRENCY=AED
