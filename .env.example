# ─── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_CHAT_ID=your_chat_id_here

# ─── External APIs ────────────────────────────────────────────────────────────
# Binance — no auth needed for market data, only for trading
BINANCE_API_KEY=
BINANCE_SECRET_KEY=

# Alpha Vantage — free: 25 req/day, paid: $50/mo for 75 req/min
ALPHA_VANTAGE_API_KEY=

# CoinGecko — demo key: 30 req/min (register at coingecko.com/api)
COINGECKO_API_KEY=CG-...

# Finnhub — free: 60 req/min (register at finnhub.io)
FINNHUB_API_KEY=

# NewsAPI — free: 100 req/day (register at newsapi.org)
NEWS_API_KEY=

# ─── Polymarket ───────────────────────────────────────────────────────────────
# Read-only: no auth needed
# Trading: requires Ethereum private key
POLYMARKET_PRIVATE_KEY=

# ─── Kalshi ───────────────────────────────────────────────────────────────────
KALSHI_API_KEY=
KALSHI_PRIVATE_KEY_PATH=./kalshi_private.pem

# ─── Security ─────────────────────────────────────────────────────────────────
CRON_SECRET=change_this_to_a_random_string_min_32_chars

# ─── App Config ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_PAPER_TRADING_CAPITAL=200000
NEXT_PUBLIC_CURRENCY=AED
